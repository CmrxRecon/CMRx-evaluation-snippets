FROM dev.passer.zyheal.com:8087/playground/cmrxrecon2025-validation:gt.v2
COPY data/ChallengeData_FlowVN/ /mnt/nas/nas3/openData/rawdata/4dFlow/ChallengeData_FlowVN/
COPY data/ChallengeData_GT/ /mnt/nas/nas3/openData/rawdata/4dFlow/ChallengeData_GT/
